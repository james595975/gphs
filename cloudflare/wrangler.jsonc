{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gunpo-school",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *", "15 15 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gunpo-school-data",
      "database_id": "ccf94115-454c-4f1f-a0d4-fa37edca4054",
      "migrations_dir": "migrations"
    }
  ]
}
